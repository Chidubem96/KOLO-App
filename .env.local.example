# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Server-side only. Powers "Ask Kolo" and alert parsing.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides:
# ANTHROPIC_MODEL=claude-opus-5          # the "Ask Kolo" adviser (default: claude-opus-5)
# ANTHROPIC_PARSE_MODEL=claude-haiku-4-5 # alert / statement parsing (default: claude-haiku-4-5)
# Cost lever: set ANTHROPIC_MODEL=claude-sonnet-5 (or claude-haiku-4-5) to spend less.
